# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Model provider ---
# Set the key for whichever provider you name below. Pi discovers a provider from
# its own environment variable, so several may be configured at once and
# AGENT_PROVIDER decides which one tasks actually run on.
OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-proj-...
# Provider and model id the agent runs on. Run `npm run models` to list what
# your key actually grants access to, and to confirm AGENT_MODEL is in the
# catalogue for AGENT_PROVIDER: the two are checked together, and a model id from
# the wrong provider is the usual reason a task fails before its first turn.
#
# OpenRouter model ids carry their upstream vendor as a prefix, so the same model
# is `gpt-5.6-terra` on the openai provider and `openai/gpt-5.6-terra` here.
AGENT_PROVIDER=openrouter
AGENT_MODEL=openai/gpt-5.6-terra
# off | minimal | low | medium | high | xhigh | max
AGENT_THINKING=medium
# Pin the upstream provider OpenRouter may send a model's calls to, by model
# id, with no fallback to another. The order is one OpenRouter provider slug,
# lower case (`deepseek`), not the display name a served call reports
# (`DeepSeek`); "data_collection":"deny" may stand beside the two keys. A value
# that is not this shape refuses startup on every ling. A valid one is ignored
# by a ling whose provider is not openrouter, and an entry for a model a ling
# does not serve is never applied, so one value can reach every child of an
# overlord. Startup prints the routing in force and /healthz `model` shows it.
# Leave it unset here for experiment runs. They will set it from the registered
# batch manifest, and their preflight, which is not built yet, will refuse to
# start when this file sets it. Until then nothing stops a value here.
# LING_MODEL_ROUTING='{"deepseek/deepseek-v4.1-flash":{"order":["deepseek"],"allow_fallbacks":false}}'

# --- HTTP API ---
# Map verified caller identities to credentials. Give each worker a distinct
# token table. The legacy AGENT_TOKEN fallback creates one "overlord" identity.
# Generate a token with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
AGENT_TOKENS_JSON='{"overlord":"replace-with-at-least-16-random-characters"}'
# AGENT_TOKEN=change-me
WORKER_ID=worker-a
# Keep this on loopback. Only widen it deliberately, and read the hardening
# section of the README first: this API runs shell commands by design.
BIND_ADDRESS=127.0.0.1
PORT=8787

# --- Budgets, per task ---
# Any one of these being exceeded aborts the run.
MAX_TURNS=40
MAX_WALL_CLOCK_MS=900000
MAX_COST_USD=2.00
# How many tasks may run at once.
MAX_CONCURRENCY=1
# Image-provided skill ids are selectable per task. Inline SKILL.md content is
# more flexible but trusted as standing instructions, so it is opt-in.
ALLOW_INLINE_SKILLS=false
MAX_SKILLS_PER_TASK=16
MAX_INLINE_SKILLS_PER_TASK=8
MAX_INLINE_SKILL_BYTES=16384
MAX_INLINE_SKILLS_TOTAL_BYTES=65536
TASK_RATE_LIMIT_PER_MINUTE=30
TASK_RATE_LIMIT_BURST=30
RATE_LIMIT_MAX_BUCKETS=10000
RATE_LIMIT_IDLE_MS=3600000
# Stop accepting requests, then let bounded tasks settle before cancellation.
SHUTDOWN_GRACE_MS=960000
SHUTDOWN_CANCEL_WAIT_MS=30000
SHUTDOWN_HTTP_CLOSE_MS=5000
# Terminal task metadata, events and workspaces are pruned after this age.
WORKSPACE_RETENTION_DAYS=30
RETENTION_INTERVAL_MS=86400000
QUEUE_RESTORE_MAX_TASKS=100
QUEUE_RESTORE_MAX_AGE_MS=86400000

# --- Browser ---
BROWSER_HEADLESS=true
# Capture a Playwright trace per task for post-mortem debugging.
BROWSER_TRACE=false

# Browser-first research uses the pinned agent-browser native binary. Leave
# AGENT_BROWSER_BIN unset for the project-local binary installed by npm.
AGENT_BROWSER_MAX_OUTPUT=12000
AGENT_BROWSER_SESSION_PREFIX=ling
AGENT_BROWSER_IDLE_TIMEOUT_MS=300000
# At most one paid recipe-repair attempt per recipe per day.
AGENT_BROWSER_REPAIR_COOLDOWN_MS=86400000

# --- Network ---
# Bound each HTTP body and all tool output entering model context. The per-turn
# cap prevents a parallel batch of individually valid responses from creating
# one unexpectedly expensive provider request.
HTTP_MAX_BODY_CHARS=12000
MAX_TOOL_RESULT_CHARS=12000
MAX_TOOL_RESULT_CHARS_PER_TURN=36000
# Set true on the VM to refuse loopback, private-range and cloud metadata
# addresses from the http_request tool. Left false for local development so
# tasks can reach services on your own machine.
BLOCK_PRIVATE_NETWORK=false

# --- Shell sandbox ---
# none  : bash runs as the service user (fine for local development)
# docker: each task gets its own container and bash runs inside it.
#         Linux only, because the workspace is bind-mounted at the same absolute
#         path. Verify with `npm run sandbox-check` before relying on it.
#         Browser tools run in the service process, so browser exploration and
#         deterministic recipe replay do not depend on this setting.
SANDBOX_MODE=none
CONTAINER_RUNTIME=podman
SANDBOX_IMAGE=node:24-bookworm-slim
# Use "none" to cut the sandbox off from the network entirely.
SANDBOX_NETWORK=bridge
SANDBOX_MEMORY=2g
SANDBOX_CPUS=2
SANDBOX_PIDS_LIMIT=512
