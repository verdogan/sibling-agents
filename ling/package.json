{
  "name": "autonomous-pi-agent",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Autonomous agent built on the Pi coding-agent SDK, driven by a private HTTP task API",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "tsx src/scripts/check.ts && tsx src/scripts/queue-check.ts && tsx src/scripts/records-check.ts",
    "records-check": "tsx src/scripts/records-check.ts",
    "integrity-check": "tsx src/scripts/integrity-check.ts",
    "egress-check": "tsx src/scripts/egress-check.ts",
    "coverage": "c8 --all --src src --reporter=text --reporter=json-summary npm run check",
    "deploy-check": "bash deploy/check.sh",
    "api-check": "tsx src/scripts/api-check.ts",
    "tools-check": "tsx src/scripts/tools-check.ts",
    "sandbox-check": "tsx src/scripts/sandbox-check.ts",
    "capability-test": "tsx src/scripts/capability-test.ts",
    "example": "tsx src/scripts/instantiate.ts",
    "models": "tsx src/scripts/models.ts",
    "smoke": "tsx src/scripts/smoke.ts",
    "browser-login": "tsx src/scripts/browser-login.ts",
    "browser:doctor": "agent-browser doctor --json",
    "browser:research-test": "tsx src/scripts/browser-research-test.ts",
    "agentic-test": "tsx src/scripts/agentic-research-test.ts",
    "monitor:explore": "tsx src/monitor/explore.ts",
    "monitor:replay": "tsx src/monitor/replay.ts",
    "monitor:check": "tsx src/scripts/monitor-check.ts",
    "prune-workspaces": "tsx src/scripts/prune-workspaces.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.0.3",
    "agent-browser": "0.33.2",
    "better-sqlite3": "^13.0.3",
    "playwright": "^1.62.1",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "c8": "^12.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "agent-browser@0.33.2": true,
    "esbuild@0.28.2": true
  }
}
