LING_BASE_URL=http://127.0.0.1:8787
LING_TOKEN=
LING_WORKSPACES_DIR=   # optional; enables disk history when co-located
LING_AUTO_START=true   # starts local ../ling only when the API is unavailable
LING_DIR=../ling       # optional path to a local ling checkout
LING_STARTUP_TIMEOUT_MS=30000
LING_REQUEST_TIMEOUT_MS=30000  # per non-streaming request attempt; 0 disables
LING_SHUTDOWN_TIMEOUT_MS=30000
# Leave empty for the existing static/local fleet. "local-task" starts one
# isolated loopback Ling process per campaign task for development proof.
LING_PROVISIONER=
LING_LOCAL_WORKER_ROOT=
LING_LOCAL_WORKER_TTL_MS=3600000
# For multiple externally managed workers, this replaces LING_BASE_URL/TOKEN.
# Give every worker its own token; do not commit the populated value.
# LING_WORKERS_JSON=[{"id":"worker-a","baseUrl":"https://worker-a.internal:8787","token":"..."},{"id":"worker-b","baseUrl":"https://worker-b.internal:8787","token":"..."}]

# Campaign/fleet ceilings. The default exposes every Ling capability; narrow
# this list only when a deployment has a concrete policy reason to do so.
FLEET_ALLOWED_TOOLS=
# Optional hard allowlists for resolved spawning-pool profiles.
FLEET_ALLOWED_PROVIDERS=
FLEET_ALLOWED_MODELS=
FLEET_ALLOWED_SKILLS=
FLEET_ALLOW_INLINE_SKILLS=false
FLEET_MAX_TASKS=8
FLEET_MAX_CONCURRENT=2
FLEET_MAX_TOTAL_COST_USD=10
# Shared by every overlord invocation on this host.
FLEET_LEDGER_PATH=
FLEET_LEDGER_RETENTION_DAYS=30
FLEET_LEDGER_INFLIGHT_STALE_MS=7200000

# Optional overlord brain. A campaign must also opt in with brain.enabled.
# An OpenAI-compatible endpoint that accepts the modern chat-completions shape:
# the request sends max_completion_tokens and response_format, and no
# temperature. An older self-hosted server that only understands max_tokens will
# reject every call, which surfaces only as a 0% brain-compliance-test rate and
# a campaign running silently on deterministic fallbacks. Measure before
# trusting a new endpoint. OPENAI_API_KEY is used when
# OVERLORD_BRAIN_API_KEY is empty.
# Any OpenAI-compatible endpoint. Testing uses OpenRouter, which also means
# OVERLORD_BRAIN_API_KEY must be set explicitly: the fallback to OPENAI_API_KEY
# would send an OpenAI key to a different provider.
OVERLORD_BRAIN_BASE_URL=https://openrouter.ai/api/v1
OVERLORD_BRAIN_MODEL=
OVERLORD_BRAIN_API_KEY=
# Set true only for a deployment serving its own model, to refuse any endpoint
# outside the cell. Leave unset for a remote provider.
OVERLORD_BRAIN_REQUIRE_CELL_LOCAL=false
OVERLORD_BRAIN_TIMEOUT_MS=60000
OVERLORD_BRAIN_MAX_ATTEMPTS=3
# Sent as max_completion_tokens. On a reasoning model this ceiling also covers
# reasoning tokens, so a value too low truncates the envelope and scores as a
# parse failure rather than an obvious error.
OVERLORD_BRAIN_MAX_OUTPUT_TOKENS=2048

# A JSON progress record is always appended to each campaign's progress.jsonl.
CAMPAIGN_PROGRESS_WEBHOOK_URL=
CAMPAIGN_PROGRESS_WEBHOOK_TOKEN=
CAMPAIGN_PROGRESS_WEBHOOK_MAX_ATTEMPTS=3
CAMPAIGN_PROGRESS_WEBHOOK_RETRY_MS=500
CAMPAIGN_STALL_MS=1200000
CAMPAIGN_LOCK_STALE_MS=86400000
CAMPAIGN_ARTIFACT_RETENTION_DAYS=90
# Windows uses ; between roots, Unix uses :
CAMPAIGN_ROOTS=

# Optional versioned profile catalogue. Campaign role entries may reference
# profile names only when this file is configured during `campaign init`.
OVERLORD_PROFILE_LIBRARY=
